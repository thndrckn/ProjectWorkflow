# Shell scripts and git hooks run under sh on every platform: keep their line endings as LF
# even where git would otherwise convert to CRLF on checkout.
*.sh text eol=lf
githooks/reference-transaction text eol=lf

# The plugin settings file is written by `claude plugin install` with plain line endings; keeping it LF
# here means a fresh install leaves git status clean where git would otherwise convert to CRLF.
.claude/settings.json text eol=lf
